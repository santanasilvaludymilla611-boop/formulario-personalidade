<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Formulário de Personalidade</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

<form action="https://webhook.site/cf554a1f-e10c-4bd7-aac5-6245c270cfbf" method="post">

<fieldset>
    <legend>Informações Pessoais</legend>

    <label for="nome">Nome:</label><br>
    <input type="text" id="nome" name="nome" required maxlength="50">

    <br><br>

    <label for="email">E-mail:</label><br>
    <input type="email" id="email" name="email" required>

    <br><br>

    <label for="idade">Idade:</label><br>
    <input type="number" id="idade" name="idade" min="10" max="100">

</fieldset>


<fieldset>
    <legend>Sobre sua Personalidade</legend>

    <p>Você se considera:</p>

    <input type="radio" id="introvertido" name="personalidade" value="Introvertido">
    <label for="introvertido">Introvertido</label><br>

    <input type="radio" id="extrovertido" name="personalidade" value="Extrovertido">
    <label for="extrovertido">Extrovertido</label><br>

    <input type="radio" id="ambivertido" name="personalidade" value="Ambivertido">
    <label for="ambivertido">Ambivertido</label>


    <p>Qual é sua maior qualidade?</p>

    <input type="radio" name="qualidade" value="Criatividade"> Criatividade<br>
    <input type="radio" name="qualidade" value="Inteligência"> Inteligência<br>
    <input type="radio" name="qualidade" value="Empatia"> Empatia<br>
    <input type="radio" name="qualidade" value="Persistência"> Persistência


    <p>Quais características combinam com você?</p>

    <input type="checkbox" name="caracteristica" value="Criativo"> Criativo<br>
    <input type="checkbox" name="caracteristica" value="Organizado"> Organizado<br>
    <input type="checkbox" name="caracteristica" value="Determinado"> Determinado<br>
    <input type="checkbox" name="caracteristica" value="Empático"> Empático


    <p>Você prefere passar seu tempo livre:</p>

    <select name="tempo">
        <option>Com amigos</option>
        <option>Com família</option>
        <option>Sozinho(a)</option>
        <option>Fazendo hobbies</option>
    </select>


    <br><br>

    <label for="descricao">Conte um pouco sobre você:</label><br>

    <textarea id="descricao" name="descricao" rows="5" cols="30"></textarea>


    <p>Qual estilo combina mais com você?</p>

    <select name="estilo">
        <option>Clássico</option>
        <option>Criativo</option>
        <option>Alternativo</option>
        <option>Esportivo</option>
    </select>


</fieldset>


<input type="submit" value="Descobrir minha personalidade">

</form>

</body>
</html>
